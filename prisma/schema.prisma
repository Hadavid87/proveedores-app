generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Proveedor {
  id              Int      @id @default(autoincrement())
  nit             String   @unique @db.VarChar(20)
  razonSocial     String   @map("razon_social") @db.VarChar(255)
  emailLogistica  String   @map("email_logistica") @db.VarChar(150)
  kamNombre       String?  @map("kam_nombre") @db.VarChar(150)
  condicionPago   CondicionPago @default(CONTADO) @map("condicion_pago")
  puntajeActual   Decimal  @default(5.00) @map("puntaje_actual") @db.Decimal(3, 2)
  estado          EstadoProveedor @default(ACTIVO)
  
  productos       ProductoProveedor[]
  ordenesCompra   OrdenCompra[]

  @@map("proveedores")
}

enum CondicionPago {
  CONTADO
  CREDITO
}

enum EstadoProveedor {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

model Producto {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique
  nombre          String
  presentacion    String?
  precioBase      Decimal  @map("precio_base") @db.Decimal(10, 2)
  fechaVencimiento DateTime? @db.Date @map("fecha_vencimiento")
  fichaTecnicaUrl String?  @map("ficha_tecnica_url")
  
  proveedores       ProductoProveedor[]
  ordenesCompraItems OrdenCompraItem[]

  @@map("productos")
}

model ProductoProveedor {
  productoId   Int @map("producto_id")
  proveedorId  Int @map("proveedor_id")
  
  producto     Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedor    Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@id([productoId, proveedorId])
  @@map("productos_proveedores")
}

model OrdenCompra {
  id              Int      @id @default(autoincrement())
  proveedorId     Int      @map("proveedor_id")
  fechaEmision    DateTime @default(now()) @map("fecha_emision")
  fechaEsperada   DateTime @map("fecha_esperada")
  estado          EstadoOC @default(EN_TIEMPO)
  
  proveedor       Proveedor @relation(fields: [proveedorId], references: [id])
  items           OrdenCompraItem[]
  
  @@map("ordenes_compra")
}

model OrdenCompraItem {
  id              Int      @id @default(autoincrement())
  ordenCompraId   Int      @map("orden_compra_id")
  productoId      Int      @map("producto_id")
  cantidad        Int
  precio          Decimal  @db.Decimal(10, 2)
  estado          EstadoItemOC @default(PENDIENTE)

  ordenCompra     OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto        Producto    @relation(fields: [productoId], references: [id])
  recepciones     RecepcionTecnica[]

  @@map("ordenes_compra_items")
}

enum EstadoItemOC {
  PENDIENTE
  CUARENTENA
  ACEPTADO
  RECHAZADO
}

enum EstadoOC {
  EN_TIEMPO
  EN_TRANSITO
  POR_VENCER
  VENCIDA
  RECIBIDA
}

model RecepcionTecnica {
  id                   Int      @id @default(autoincrement())
  ordenCompraItemId    Int      @map("orden_compra_item_id")
  lote                 String   @db.VarChar(50)
  cantidadRecibida     Int      @map("cantidad_recibida")
  temperatura          String?  @db.VarChar(50)
  fechaVencimiento     DateTime @db.Date @map("fecha_vencimiento")
  
  defectosCriticos     Int      @default(0) @map("defectos_criticos")
  defectosMayores      Int      @default(0) @map("defectos_mayores")
  defectosMenores      Int      @default(0) @map("defectos_menores")
  regSanitarioVerificado Boolean @default(false) @map("reg_sanitario_verificado")
  
  evalEmpaque          Int      @default(1) @map("eval_empaque")
  evalEtiqueta         Int      @default(1) @map("eval_etiqueta")
  evalCaracteristicas  Int      @default(1) @map("eval_caracteristicas")
  puntajeFinal         Int      @default(1) @map("puntaje_final")
  porcentaje           Decimal  @default(0) @map("porcentaje") @db.Decimal(5, 2)

  estado               EstadoItemOC @default(PENDIENTE)
  
  ordenCompraItem      OrdenCompraItem @relation(fields: [ordenCompraItemId], references: [id], onDelete: Cascade)
  
  @@map("recepciones_tecnicas")
}

model CapaTicket {
  id          Int      @id @default(autoincrement())
  proveedorId Int      @map("proveedor_id")
  fechaGeneracion DateTime @default(now()) @map("fecha_generacion")
  descripcion String   @db.Text
  estado      String   @default("ABIERTO")

  @@map("capa_tickets")
}
